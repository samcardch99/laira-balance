---
import Layout from "../../layouts/Layout.astro";
import TicketSelector from "../../components/friendsgiving/TicketSelector";
---

<Layout
  title="Laira Friendsgiving"
  description="Get your ticket for Laira Friendsgiving at Laira Balance Studio: member, early bird and general tickets, 30 spots only."
>
  <section
    id="friendsgiving"
    class="flex flex-col gap-12 w-full min-h-screen bg-secondary px-8 md:px-10 lg:px-20 pt-32 pb-10"
  >
    <div class="prose prose-xl text-primary">
      <h1 class="italic font-bold text-5xl lg:text-6xl thin-screen:text-3xl text-primary">
        Laira Friendsgiving
      </h1>
      <p class="text-lg">A gathering to give thanks, move together and share the table with our community. Only 30 spots.</p>
    </div>
    <TicketSelector client:load lang="en" />
  </section>
</Layout>
