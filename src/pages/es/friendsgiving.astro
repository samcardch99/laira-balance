---
import Layout from "../../layouts/Layout.astro";
import TicketSelector from "../../components/friendsgiving/TicketSelector";
---

<Layout
  title="Laira Friendsgiving"
  description="Reserva tu entrada para Laira Friendsgiving en Laira Balance Studio: entradas de miembro, early bird y general, solo 30 cupos."
>
  <section
    id="friendsgiving"
    class="flex flex-col gap-12 w-full min-h-screen bg-secondary px-8 md:px-10 lg:px-20 pt-32 pb-10"
  >
    <div class="prose prose-xl text-primary">
      <h1 class="italic font-bold text-5xl lg:text-6xl thin-screen:text-3xl text-primary">
        Laira Friendsgiving
      </h1>
      <p class="text-lg">Un encuentro para dar gracias, movernos juntas y compartir mesa con nuestra comunidad. Solo 30 cupos.</p>
    </div>
    <TicketSelector client:load lang="es" />
  </section>
</Layout>
